{
  "name": "main",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "pnpm run build && next start -p 3000",
    "lint": "eslint",
    "article:create": "node src/scripts/create-article.js",
    "article:publish": "node src/scripts/publish-article.js",
    "clean": "rm -rf node_modules .next .turbo dist",
    "env:use:local": "dotenvx decrypt -f .envx.local --stdout > .env",
    "env:use:prod": "dotenvx decrypt -f .envx.production --stdout > .env",
    "env:encrypt:local": "dotenvx encrypt -f .envx.local",
    "env:encrypt:prod": "dotenvx encrypt -f .envx.production"
  },
  "dependencies": {
    "@next/third-parties": "16.3.0",
    "@repo/runtime-env": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.72.0",
    "@shikijs/transformers": "^4.4.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "front-matter": "^4.0.2",
    "geist": "1.7.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "import-in-the-middle": "3.3.3",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "next": "16.3.0",
    "next-mdx-remote-client": "^2.1.12",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-haiku": "^2.4.1",
    "react-icons": "5.7.0",
    "rehype-mdx-code-props": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "require-in-the-middle": "8.0.1",
    "sharp": "0.35.4",
    "shiki": "^4.4.3",
    "slugify": "^1.6.9",
    "tailwind-merge": "3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/terminal-kit": "^2.5.7",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "terminal-kit": "^3.1.4",
    "typescript": "5.9.3"
  }
