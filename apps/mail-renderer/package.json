    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "tsdown": "0.23.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
