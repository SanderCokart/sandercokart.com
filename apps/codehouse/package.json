{
  "name": "codehouse",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "build": "next build",
    "start": "pnpm run build && next start -p 3001",
    "lint": "eslint .",
    "clean": "rm -rf node_modules .next .turbo dist",
    "i18n:check:en": "i18n-check --source en --locales messages",
    "i18n:check:nl": "i18n-check --source nl --locales messages",
    "env:use:local": "dotenvx decrypt -f .envx.local --stdout > .env",
    "env:use:prod": "dotenvx decrypt -f .envx.production --stdout > .env",
    "env:encrypt:local": "dotenvx encrypt -f .envx.local",
    "env:encrypt:prod": "dotenvx encrypt -f .envx.production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mantine/hooks": "^9.5.2",
    "@repo/runtime-env": "workspace:*",
    "@repo/toolbox": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.72.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "country-flag-icons": "1.6.20",
    "fast-glob": "^3.3.3",
    "geist": "1.7.2",
    "import-in-the-middle": "3.3.3",
    "jiti": "^2.7.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "next": "16.3.0",
    "next-intl": "4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.4",
    "react-hook-form": "^7.87.0",
    "react-icons": "5.7.0",
    "react-remove-scroll": "^2.7.2",
    "require-in-the-middle": "8.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "use-intl": "^4.13.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@lingual/i18n-check": "^0.9.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
