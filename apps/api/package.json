{
    "name": "api",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "composer install --no-interaction --no-ansi",
        "dev": "concurrently \"@php artisan serve\" \"vite\"",
        "clean": "rm -rf node_modules .next .turbo dist",
        "build": "vite build",
        "env:use:local": "dotenvx decrypt -f .envx.local --stdout > .env",
        "env:use:docker": "dotenvx decrypt -f .envx.docker --stdout > .env",
        "env:use:production": "dotenvx decrypt -f .envx.production --stdout > .env",
        "env:use:staging": "dotenvx decrypt -f .envx.staging --stdout > .env",
        "env:staging:check": "node ../../scripts/dokploy-env.mjs check staging --app api",
        "env:staging:pull": "node ../../scripts/dokploy-env.mjs pull staging --app api"
    },
    "devDependencies": {
        "axios": "^1.20.0",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.2.0",
        "vite": "^8.2.2"
    }
}
