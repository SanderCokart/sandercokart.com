{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": ["./apps/api/artisan", "boost:mcp"]
    },
    "next-devtools": {
      "command": "/home/sander/.local/share/mise/shims/npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "dokploy-mcp": {
      "command": "npx",
      "args": ["dotenvx", "run", "-f", ".env", "--", "npx", "-y", "@dokploy/mcp"],
      "env": {
        "DOKPLOY_TOOL_PRESET": "all",
        "DOKPLOY_REDACT_ENV": "false"
      }
    }
  }
}
