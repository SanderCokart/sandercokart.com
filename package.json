{
  "name": "sandercokart.com",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.19.0"
    }
  },
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "lint": "turbo lint",
    "test:visual": "turbo run test:visual --concurrency=1 --ui=stream",
    "test:visual:update": "turbo run test:visual:update --concurrency=1 --ui=stream",
    "test:visual:install": "pnpm --filter @repo/playwright-visual exec playwright install chromium",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "clean": "turbo clean && echo 'Deleting root node_modules...' && rm -rf node_modules .next .turbo dist"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "(apps|packages)/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "(apps|packages)/*.{css,scss}": [
      "prettier --write"
    ],
    "apps/sandercokart.com/**/*.mdx": [
      "node ./scripts/article-update.js"
    ]
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.22.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.11.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4",
      "@types/hast": "3.0.5"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "core-js-pure",
      "es5-ext",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
