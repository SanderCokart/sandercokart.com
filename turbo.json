{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "NEXT_OUTPUT",
        "NEXT_PUBLIC_*",
        "VITE_*",
        "DOTENV_PRIVATE_KEY_PRODUCTION",
        "APP_ENV",
        "APP_URL",
        "SITE_URL",
        "GITHUB_TOKEN",
        "MAIL_*",
        "REDIS_*"
      ],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "inputs": ["$TURBO_DEFAULT$", "!*.env*", "!**/*.env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test:visual": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "test:visual:update": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["DOTENV_PRIVATE_KEY*"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  }
}
